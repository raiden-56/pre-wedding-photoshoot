{
  "name": "saanjh-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-postgres.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx --env-file=.env --conditions=react-server prisma/seed.ts",
    "worker": "tsx --env-file=.env --conditions=react-server scripts/worker.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --env-file=.env --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-three/fiber": "^9.8.2",
    "archiver": "^8.0.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "19.2",
    "react-dom": "19.2",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
