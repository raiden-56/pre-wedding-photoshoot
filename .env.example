# ---- Database (local dev: `npm run db:local` starts an embedded PostgreSQL on 5433)
DATABASE_URL="postgresql://lumiere:lumiere_dev@localhost:5433/lumiere?schema=public"

# ---- App
APP_URL="http://localhost:3100"
# 32+ random bytes; used to sign media URLs, upload tickets and guest tokens
APP_SECRET="dev-only-change-me-7f3a9c1e5b2d4a8f9e0c6b1a3d5f7e9c"

# ---- Storage: "local" (./.data/storage, served via signed URLs) or "s3"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (leave empty to disable; deliveries are recorded as SKIPPED)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Lumière Frames <studio@example.com>"

# ---- Razorpay (leave empty to disable online payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- WhatsApp Cloud API (optional; share links work without it)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---- Google Maps embed (optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
